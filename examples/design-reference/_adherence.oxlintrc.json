{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/agent/**",
              "components/buttons/**",
              "components/data/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ui_kits/console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|size|children|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: role, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:agent|user)$/]",
        "message": "<Avatar> role must be one of 'agent' | 'user'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|icon|mono|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, icon, mono, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|danger|warning|info|ink)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'success' | 'danger' | 'warning' | 'info' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|disabled|loading|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, disabled, loading, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|raised|padding|interactive|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, raised, padding, interactive, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|white|accent|ghost)$/]",
        "message": "<Card> tone must be one of 'default' | 'white' | 'accent' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|timestamp|children|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: role, timestamp, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:user|agent)$/]",
        "message": "<ChatBubble> role must be one of 'user' | 'agent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|selected|icon|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, selected, icon, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|entity)$/]",
        "message": "<Chip> tone must be one of 'default' | 'entity'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|active|disabled|title|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: size, variant, active, disabled, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|solid)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|hint|error|size|mono|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, icon, hint, error, size, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MandateCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:ordinal|label|universe|maxOrder|dailyCap|leverage|notes|active|onCommit|key|ref|className|style|children)$/]",
        "message": "<MandateCard> doesn't accept that prop. Declared props: ordinal, label, universe, maxOrder, dailyCap, leverage, notes, active, onCommit."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|sentiment|sub|align|key|ref|className|style|children)$/]",
        "message": "<MetricTile> doesn't accept that prop. Declared props: label, value, sentiment, sub, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute[name.name='sentiment'] > Literal[value!=/^(?:positive|negative|neutral)$/]",
        "message": "<MetricTile> sentiment must be one of 'positive' | 'negative' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|start)$/]",
        "message": "<MetricTile> align must be one of 'center' | 'start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|tone|height|showCount|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: current, total, tone, height, showCount."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|ink|danger|warning|info)$/]",
        "message": "<ProgressBar> tone must be one of 'accent' | 'ink' | 'danger' | 'warning' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='height'] > Literal[value!=/^(?:xs|sm|md)$/]",
        "message": "<ProgressBar> height must be one of 'xs' | 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwarmAgentRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|status|tool|elapsed|iterations|output|key|ref|className|style|children)$/]",
        "message": "<SwarmAgentRow> doesn't accept that prop. Declared props: name, role, status, tool, elapsed, iterations, output."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwarmAgentRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:waiting|running|done|failed|blocked|retry|cancelled)$/]",
        "message": "<SwarmAgentRow> status must be one of 'waiting' | 'running' | 'done' | 'failed' | 'blocked' | 'retry' | 'cancelled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tab'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|active|onClose|onClick|key|ref|className|style|children)$/]",
        "message": "<Tab> doesn't accept that prop. Declared props: label, icon, active, onClose, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolCallRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|kind|detail|onClick|key|ref|className|style|children)$/]",
        "message": "<ToolCallRow> doesn't accept that prop. Declared props: label, kind, detail, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolCallRow'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:tool|thought)$/]",
        "message": "<ToolCallRow> kind must be one of 'tool' | 'thought'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WatchlistRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|icon|selected|change|changeDirection|onClick|key|ref|className|style|children)$/]",
        "message": "<WatchlistRow> doesn't accept that prop. Declared props: symbol, icon, selected, change, changeDirection, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='WatchlistRow'] > JSXAttribute[name.name='changeDirection'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<WatchlistRow> changeDirection must be one of 'up' | 'down'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
