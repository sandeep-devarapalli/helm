{
  "name": "helm",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @helm/web dev",
    "lint": "pnpm -r lint && node scripts/verify-runtime-locks.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @helm/web test:e2e",
    "build": "pnpm -r build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@<=5.0.7": ">=5.0.8"
    }
  }
}
